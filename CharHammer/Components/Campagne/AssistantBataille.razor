@using CharHammer.Components.Bestiole

@inject AppState AppState
@implements IDisposable
@code{
    [Parameter, EditorRequired] public IEnumerable<CombattantEnJeu> Protagonistes { get; set; } = null!;

    // Adversaires possibles de chaque camp : calculés une fois par paramétrage plutôt qu'une fois par ligne.
    CombattantEnJeu[] _ennemis = [];
    CombattantEnJeu[] _allies = [];

    protected override void OnInitialized() => AppState.OnChange += StateHasChanged;

    protected override void OnParametersSet()
    {
        _ennemis = Protagonistes.Where(p => p.Ennemi).ToArray();
        _allies = Protagonistes.Where(p => !p.Ennemi).ToArray();
    }

    public void Dispose() => AppState.OnChange -= StateHasChanged;
}
<table class="table table-striped">
    <thead>
        <tr class="tgroupe">
            <th></th>
            <th class="ps-2">Combattant</th>
            <th class="ps-2">Adversaire</th>
            <th class="ps-2">Compétences</th>
            <th class="ps-2 text-center">CC</th>
            <th class="ps-2 text-center">BF</th>
            <th class="ps-2 text-center">BE</th>
            <th class="ps-2">Avantage</th>
            <th class="ps-2">Blessures</th>
            <th class="ps-2">Protections</th>
            <th class="ps-2">Aptitudes</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var combattant in Protagonistes)
    {
        <CombattantRow @key=@combattant Item=@combattant Adversaires=@(combattant.Ennemi ? _allies : _ennemis) />
    }
    </tbody>
</table>