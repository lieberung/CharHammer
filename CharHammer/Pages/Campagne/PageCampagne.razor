@page "/campagne/{CampagneId:int}/seances/"

@using CharHammer.Components.Campagne

@inject CampagnesService Service
@code {
    [Parameter] public int CampagneId { get; set; }

    CampagneDto? _campagne;

    protected override void OnParametersSet() => _campagne = Service.GetCampagne(CampagneId);
}
<TopRowTitleSection Title="Carnets de Campagne" />
<div class="row section">
    @foreach (var campagne in Service.AllCampagnes)
    {
        <div class="col-3">
            <LinkCampagne Titre=@campagne.Titre CampagneId=@campagne.Id Actif=@(campagne.Id == CampagneId) />
        </div>
    }
</div>
<div class="section">
    @if (_campagne is null)
    {
        <p role="alert" class="fst-italic">Aucune campagne ne porte ce numéro : choisissez-en une ci-dessus.</p>
    }
    else
    {
        <CampagneDetail Campagne=@_campagne />
    }
</div>
