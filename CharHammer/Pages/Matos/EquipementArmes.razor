@page "/equipement/armes-liste/{Type}/{SousFiltre}/{Groupe?}/"
@layout FluidLayout

@using CharHammer.Components.Arme

@inject ArmesService Service
@inject AptitudesService AptitudesService
@code {
    // Adresse : /equipement/armes-liste/{toutes|melee|tir}/{sous-filtre|toutes}/{groupe d'armes|toutes}/
    [Parameter] public string Type { get; set; } = "toutes";
    [Parameter] public string SousFiltre { get; set; } = "toutes";
    [Parameter] public string? Groupe { get; set; }

    /// <summary>Un bouton de sous-filtre : une spécialisation de Mêlée ou de Tir, ou les munitions.</summary>
    sealed record Categorie(string Slug, string Libelle, bool DeMelee, IReadOnlyList<ArmeDto> ArmesDeContact, IReadOnlyList<ArmeDto> ArmesDeTir);

    sealed record Tableau(string Titre, IReadOnlyList<ArmeDto> Armes, bool ArmesDeTir);

    // Ne dépendent que des données : calculées une fois.
    IReadOnlyList<Categorie> _categoriesMelee = [];
    IReadOnlyList<Categorie> _categoriesTir = [];
    Categorie _munitions = null!;

    string _type = "toutes";
    Categorie? _categorie;
    ArmeAttributDto? _groupe;
    IReadOnlyList<Tableau> _tableaux = [];

    protected override void OnInitialized()
    {
        _categoriesMelee = AptitudesService.AllMeleeSpecialisations
            .Select(c => CreerCategorie(c, NomCourt(c.Spe!), deMelee: true))
            .Where(c => c.ArmesDeContact.Count + c.ArmesDeTir.Count > 0)
            .ToArray();
        _categoriesTir = AptitudesService.AllTirSpecialisations
            .Select(c => CreerCategorie(c, c.Spe!, deMelee: false))
            .Where(c => c.ArmesDeContact.Count + c.ArmesDeTir.Count > 0)
            .ToArray();
        _munitions = new Categorie("munitions", "Munitions", false, [], Service.AllArmes.Where(a => a.EstUneMunition).OrderBy(a => a.Nom).ToArray());
    }

    protected override void OnParametersSet()
    {
        _type = Type is "melee" or "tir" ? Type : "toutes";
        _categorie = Categories.FirstOrDefault(c => c.Slug == SousFiltre && EstVisible(c, _type));
        _groupe = Groupe is null or "toutes" ? null : Service.AllGroupesDArmes.FirstOrDefault(g => Slug(g.Nom) == Groupe);

        var avecContact = _type != "tir";
        var avecTir = _type != "melee";
        var tableaux = new List<Tableau>();

        if (_categorie is null)
        {
            // Pas de sous-filtre : toutes les armes du type choisi, réparties par famille.
            if (avecContact)
                tableaux.AddRange(ParFamille(Service.ArmesDeContactPourTable, Service.AllArmes.Where(a => a.EstUneArmeDeCaC), false));
            if (avecTir)
                tableaux.AddRange(ParFamille(Service.ArmesADistancePourTable, Service.AllArmes.Where(a => a.EstUneArmeDeTir), true));
        }
        else
        {
            // Sous-filtre : exactement les armes de cette catégorie.
            if (avecContact)
                tableaux.Add(new Tableau(_categorie.Libelle, FiltrerParGroupe(_categorie.ArmesDeContact), false));
            if (avecTir)
                tableaux.Add(new Tableau(_categorie.Libelle, FiltrerParGroupe(_categorie.ArmesDeTir), true));
        }

        _tableaux = tableaux.Where(t => t.Armes.Count > 0).ToArray();
    }

    IEnumerable<Categorie> Categories => _categoriesMelee.Concat(_categoriesTir).Append(_munitions);

    /// <summary>
    /// Mêlée : spécialisations de Mêlée ayant au moins une arme de contact (les catégories de Tir et les munitions sont masquées).
    /// Tir : l'inverse, spécialisations de Tir et munitions ayant au moins une arme de tir.
    /// </summary>
    static bool EstVisible(Categorie categorie, string type) => type switch
    {
        "melee" => categorie.DeMelee && categorie.ArmesDeContact.Count > 0,
        "tir" => !categorie.DeMelee && categorie.ArmesDeTir.Count > 0,
        _ => true
    };

    Categorie CreerCategorie(AptitudeDto competence, string libelle, bool deMelee)
    {
        var armes = Service.AllArmes
            .Where(a => a.CompetencesDeMaitrise.Any(c => c.Id == competence.Id))
            .OrderBy(a => a.Nom)
            .ToArray();
        return new Categorie(Slug(libelle), libelle, deMelee, armes.Where(a => a.EstUneArmeDeCaC).ToArray(), armes.Where(a => a.EstUneArmeDeTir).ToArray());
    }

    IEnumerable<Tableau> ParFamille(IReadOnlyDictionary<string, IReadOnlyList<ArmeDto>> familles, IEnumerable<ArmeDto> armesDuType, bool armesDeTir)
    {
        var retenues = armesDuType.ToHashSet();
        return familles.Select(f => new Tableau(f.Key, FiltrerParGroupe(f.Value.Where(retenues.Contains)), armesDeTir));
    }

    IReadOnlyList<ArmeDto> FiltrerParGroupe(IEnumerable<ArmeDto> armes)
    {
        var groupe = _groupe;
        return (groupe is null ? armes : armes.Where(a => a.Groupes.Contains(groupe))).ToArray();
    }

    static string Slug(string libelle) => GenericService.GetUrlChunk(libelle);

    static string NomCourt(string spe)
    {
        var str = spe
            .Replace("Armes d'", "")
            .Replace("Armes de ", "")
            .Replace("Armes ", "");
        return str[..1].ToUpper() + str[1..];
    }

    string Lien(string type, string sousFiltre, string? groupe)
        => $"equipement/armes-liste/{type}/{sousFiltre}/{groupe ?? "toutes"}/";

    string GroupeCourant => _groupe is null ? "toutes" : Slug(_groupe.Nom);

    // Changer de type garde le sous-filtre s'il existe encore pour ce type.
    string LienType(string type)
        => Lien(type, _categorie is not null && EstVisible(_categorie, type) ? _categorie.Slug : "toutes", GroupeCourant);

    // Cliquer sur le sous-filtre actif le désélectionne.
    string LienCategorie(Categorie c) => Lien(_type, c == _categorie ? "toutes" : c.Slug, GroupeCourant);

    string LienGroupe(ArmeAttributDto g) => Lien(_type, _categorie?.Slug ?? "toutes", g == _groupe ? "toutes" : Slug(g.Nom));

    static string Bouton(bool actif) => $"mb-1 me-1 btn btn-sm {(actif ? "btn-primary" : "btn-secondary")}";
}
<TopRowTitleSection Title="Armes" />

<div class="mt-2">
    <div>
        <a href="@LienType("toutes")" class="@Bouton(_type == "toutes")">Toutes</a>
        <a href="@LienType("melee")" class="@Bouton(_type == "melee")">Mélée</a>
        <a href="@LienType("tir")" class="@Bouton(_type == "tir")">Tir</a>

        @if (_categoriesMelee.Any(c => EstVisible(c, _type)))
        {
            <ItemIcon Icon="infinity" Classes="ms-3 me-4" />
            @foreach (var c in _categoriesMelee.Where(c => EstVisible(c, _type)))
            {
                <a href="@LienCategorie(c)" class="@Bouton(c == _categorie)">@c.Libelle</a>
            }
        }

        @if (_categoriesTir.Any(c => EstVisible(c, _type)) || EstVisible(_munitions, _type))
        {
            <ItemIcon Icon="infinity" Classes="ms-3 me-4" />
            @foreach (var c in _categoriesTir.Where(c => EstVisible(c, _type)))
            {
                <a href="@LienCategorie(c)" class="@Bouton(c == _categorie)">@c.Libelle</a>
            }
            @if (EstVisible(_munitions, _type))
            {
                <a href="@LienCategorie(_munitions)" class="@Bouton(_munitions == _categorie)">@_munitions.Libelle</a>
            }
        }
    </div>
    <div>
        @foreach (var groupeDArmes in Service.AllGroupesDArmes)
        {
            <a href="@LienGroupe(groupeDArmes)" class="@Bouton(groupeDArmes == _groupe)">@groupeDArmes.Nom</a>
        }
    </div>
</div>

@foreach (var tableau in _tableaux)
{
    <ArmeGroupeTable @key=@((tableau.Titre, tableau.ArmesDeTir)) Armes=@tableau.Armes Groupe=@tableau.Titre ArmesDeTir=@tableau.ArmesDeTir />
}
@if (_tableaux.Count == 0)
{
    <p class="mt-3 fst-italic">Aucune arme ne correspond à ces filtres.</p>
}
@if (_groupe is not null)
{
    <div class="row">
        <div class="col">
            <div class="bulle shadow-sm">
                <h6>@_groupe.Nom</h6>
                <CardParagraphes Text=@_groupe.Description />
            </div>
        </div>
    </div>
}
